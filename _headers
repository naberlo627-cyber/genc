# Cloudflare Pages önbellek ayarları.
# Uygulama sayfası ve veri her zaman taze gelmeli; simgeler uzun süre önbellekte kalabilir.

/Genc.html
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/version.json
  Cache-Control: public, max-age=0, must-revalidate

/data/events.json
  Cache-Control: public, max-age=0, must-revalidate

/icons/*
  Cache-Control: public, max-age=604800

/img/*
  Cache-Control: public, max-age=604800
