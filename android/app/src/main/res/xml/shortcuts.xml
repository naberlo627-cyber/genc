<?xml version="1.0" encoding="utf-8"?>
<!--
  Statik kısayollar. Başlatıcılar en fazla 4-5 kısayol gösterir; bu yüzden en
  değerli beş tanesi sırayla tanımlanır: Ara, Salonlar, Biletlerim, Bildirimler,
  Profil. Alt menüde tek dokunuşla açılan sekmeler (Ana Sayfa, Keşfet) bilinçli
  olarak kısayol değildir. Uygulamaya özgü ek kısayollar (hafta, bilet-al, yakin,
  videolar, hoşlandıklarım) PWA manifestinde kalır. Son bakılan etkinlik için
  dinamik kısayol Java tarafında eklenir. Android statik kısayollarda sıra
  numarası kabul etmez; dinamik kısayolun öne geçmesi için statikler burada
  tanımlı sırayla gösterilir, dinamik kısayol ise setDynamicShortcuts ile
  ayrı listelenir.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:shortcutId="ara"
        android:enabled="true"
        android:icon="@drawable/sc_ara"
        android:shortcutShortLabel="@string/sc_ara">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.genc.app"
            android:targetClass="com.genc.app.MainActivity"
            android:data="https://appassets.androidplatform.net/assets/www/Genc.html?git=ara" />
    </shortcut>

