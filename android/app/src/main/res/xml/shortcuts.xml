<?xml version="1.0" encoding="utf-8"?>
<!--
  Uzun basma kısayolları. Başlatıcılar en fazla 4-5 kısayol gösterdiği için
  sıra önemlidir: en çok kullanılanlar (ara, biletlerim, yakin, hafta) başta
  durur; liste kırpılsa bile bunlar görünür. Alt menüde tek dokunuşla açılan
  sekmeler (Ana Sayfa, Keşfet) bilinçli olarak kısayol değildir. Son bakılan
  etkinlik için dinamik kısayol Java tarafında (MainActivity) eklenir ve
  setRank(0) ile listenin başına geçer.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:shortcutId="ara"
        android:enabled="true"
        android:icon="@drawable/sc_ara"
        android:shortcutShortLabel="@string/sc_ara"
        android:shortcutLongLabel="@string/sc_ara_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.genc.app"
            android:targetClass="com.genc.app.MainActivity"
            android:data="https://appassets.androidplatform.net/assets/www/Genc.html?git=ara" />
    </shortcut>

