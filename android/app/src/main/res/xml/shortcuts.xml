<?xml version="1.0" encoding="utf-8"?>
<!--
  Statik kısayollar. Çoğu başlatıcı en fazla 4 kısayol gösterir (üst sınır ~5);
  bu yüzden her uygulamada beklenen en değerli 5 tanesi sırayla tanımlanır:
  Ara, Biletlerim, Bildirimler, Hoşlandıklarım, Profil. Alt menüde tek
  dokunuşla açılan sekmeler bilinçli olarak kısayol değildir. Uygulamaya özgü
  ek kısayollar (hafta, bilet-al, yakin) PWA manifestinde kalır.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:shortcutId="ara"
        android:enabled="true"
        android:icon="@drawable/sc_ara"
        android:shortcutShortLabel="@string/sc_ara">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.genc.app"
            android:targetClass="com.genc.app.MainActivity"
            android:data="https://appassets.androidplatform.net/assets/www/Genc.html?git=ara" />
    </shortcut>

